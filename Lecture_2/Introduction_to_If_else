```java
public class Main
{
	public static void main(String[] args) {
	    int[] numbers = {5, 8, 2, 9, 1};
	    int target = 9;
	    boolean found = false;
	    for (int i = 0; i < numbers.length; i++) {
	        if (numbers[i] == target) {
	            System.out.println("Found at index " + i);
	            found = true;
	            break;
	        }
	    }
	    if (!found) {
	        System.out.println("Not found");
	    }
	}
}
